#!/usr/bin/env bash
# Usage: scripts/image-versions images/<name>
#
# Prints agent_version=… and supervisor_version=… (GITHUB_OUTPUT format),
# read from the tags on the Dockerfile's `AS agent` and `AS supervisor`
# stages. The Dockerfile is the only place a version is written down, so
# the published tags cannot disagree with what was built.
set -euo pipefail

dockerfile="${1:?usage: $0 images/<name>}/Dockerfile"

stage_tag() {
  local ref tag
  ref=$(sed -nE "s/^FROM ([^ @]+)(@sha256:[0-9a-f]+)? AS $1\$/\1/p" "$dockerfile")
  tag="${ref##*:}"
  # No tag at all leaves the repository path (or a registry port) behind.
  if [ -z "$ref" ] || [ "$tag" = "$ref" ] || [[ "$tag" == */* ]]; then
    echo "error: no tagged FROM … AS $1 stage in $dockerfile" >&2
    exit 1
  fi
  echo "$tag"
}

agent=$(stage_tag agent)
supervisor=$(stage_tag supervisor)

# An agent tag can carry a variant after its version (Vector's
# 0.59.0-distroless-static), which names the upstream build, not the
# release. The published tag names the release alone.
agent_release=$(grep -oE '^v?[0-9]+(\.[0-9]+)*' <<<"$agent" || true)
if [ -z "$agent_release" ]; then
  echo "error: agent tag $agent does not start with a version" >&2
  exit 1
fi
agent="$agent_release"

# The supervisor's release tags carry a leading v; the image tag drops it
# so the suffix reads as one version (0.162.0-ampbase0.17.0).
echo "agent_version=${agent}"
echo "supervisor_version=${supervisor#v}"
